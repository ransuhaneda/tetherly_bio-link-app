{
  "name": "tetherly",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @tetherly/web dev",
    "build": "pnpm --filter @tetherly/web build",
    "preview": "pnpm --filter @tetherly/web preview",
    "test": "pnpm --filter @tetherly/web test",
    "test:run": "pnpm --filter @tetherly/web test:run",
    "type-check": "pnpm --filter @tetherly/web type-check",
    "lint": "pnpm --filter @tetherly/web lint",
    "lint:styles": "pnpm --filter @tetherly/web lint:styles",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev:api": "cd apps/api && php artisan serve --host=localhost --port=8000",
    "test:api": "cd apps/api && php artisan test"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "eslint": "10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "16.2.0",
    "prettier": "^3.6.2",
    "stylelint": "16.24.0"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "apps/web/**/*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
